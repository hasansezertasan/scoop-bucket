# EditorConfig is awesome: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
max_line_length = 88

[*.{json,jsonc,md,sh,yml,yaml,toml}]
indent_size = 2

# cobo.lock is a generated TOML lockfile; the `.lock` extension falls outside
# the TOML glob above, so it needs its own stanza.
[cobo.lock]
indent_size = 2

# .gitignore is generated by Cobo from upstream github/gitignore templates,
# which ship trailing whitespace on some comment lines. Trimming it would break
# the hash seal recorded in cobo.lock.
[.gitignore]
trim_trailing_whitespace = false

[*.{png,jpg,gif,ico,woff,woff2,ttf,eot,svg,pdf}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
max_line_length = unset

[*.{diff,patch}]
trim_trailing_whitespace = false
